<Window x:Class="GelesiyeWPF.Views.Dialogs.AyarlarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GelesiyeWPF.Converters"
        Title="{conv:Loc Title_Ayarlar}" Width="620" Height="580" MinWidth="540" MinHeight="480"
        Icon="pack://application:,,,/Assets/gelesiye.ico"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <Border Grid.Row="0" Background="#107FD2" MouseLeftButtonDown="Header_MouseDown">
            <Grid Margin="16,0,8,0">
                <TextBlock Text="{conv:Loc Title_Ayarlar}" Foreground="White" FontFamily="Segoe UI"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        FontSize="14" Cursor="Hand" Width="30" Height="30"
                        Click="BtnIptal_Click"/>
            </Grid>
        </Border>

        <!-- Sekmeler -->
        <TabControl x:Name="tcAyarlar" Grid.Row="1" Margin="14,10,14,6" Background="White" BorderBrush="#E2E8F0">
            <!-- 1. Firma Bilgileri -->
            <TabItem Header="{conv:Loc Tab_Firma}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol Sütun -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="{conv:Loc Lbl_FirmaUnvani}" Style="{StaticResource DlgLabel}"/>
                            <TextBox x:Name="edtFirmaUnvan" Style="{StaticResource DlgInput}"/>

                            <TextBlock Text="{conv:Loc Lbl_Telefon}" Style="{StaticResource DlgLabel}"/>
                            <TextBox x:Name="edtFirmaTelefon" Style="{StaticResource DlgInput}"/>

                            <TextBlock Text="{conv:Loc Lbl_Faks}" Style="{StaticResource DlgLabel}"/>
                            <TextBox x:Name="edtFirmaFaks" Style="{StaticResource DlgInput}"/>
                        </StackPanel>

                        <!-- Sağ Sütun -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="{conv:Loc Lbl_Il}" Style="{StaticResource DlgLabel}"/>
                            <ComboBox x:Name="cmbFirmaIl" Style="{StaticResource DlgCombo}" IsEditable="True"
                                      SelectionChanged="CmbFirmaIl_SelectionChanged"/>

                            <TextBlock Text="{conv:Loc Lbl_Ilce}" Style="{StaticResource DlgLabel}"/>
                            <ComboBox x:Name="cmbFirmaIlce" Style="{StaticResource DlgCombo}" IsEditable="True"/>

                            <TextBlock Text="{conv:Loc Lbl_VergiDairesi}" Style="{StaticResource DlgLabel}"/>
                            <TextBox x:Name="edtFirmaVergiDairesi" Style="{StaticResource DlgInput}"/>

                            <TextBlock Text="{conv:Loc Lbl_VergiNo}" Style="{StaticResource DlgLabel}"/>
                            <TextBox x:Name="edtFirmaVergiNo" Style="{StaticResource DlgInput}"/>
                        </StackPanel>

                        <!-- Adres (Alt Satır, Tam Genişlik) -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0">
                            <TextBlock Text="{conv:Loc Lbl_Adres}" Style="{StaticResource DlgLabel}"/>
                            <TextBox x:Name="edtFirmaAdres" Style="{StaticResource DlgInput}" Height="54"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 2. Genel Ayarlar -->
            <TabItem Header="{conv:Loc Tab_Genel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,14">
                        <TextBlock Text="{conv:Loc Lbl_ParaBirimi}" Style="{StaticResource DlgLabel}"/>
                        <ComboBox x:Name="cmbParaBirimi" Style="{StaticResource DlgCombo}" Width="160" HorizontalAlignment="Left" IsEditable="True">
                            <ComboBoxItem Content="TL"/>
                            <ComboBoxItem Content="USD"/>
                            <ComboBoxItem Content="EUR"/>
                        </ComboBox>

                        <TextBlock Text="{conv:Loc Lbl_Dil}" Style="{StaticResource DlgLabel}" Margin="0,14,0,3"/>
                        <ComboBox x:Name="cmbDil" Style="{StaticResource DlgCombo}" Width="160" HorizontalAlignment="Left"
                                  SelectionChanged="CmbDil_SelectionChanged">
                            <ComboBoxItem Content="Türkçe (tr-TR)"/>
                            <ComboBoxItem Content="English (en-US)"/>
                        </ComboBox>

                        <TextBlock Text="{conv:Loc Lbl_KapatmaEylemi}" Style="{StaticResource DlgLabel}" Margin="0,14,0,3"/>
                        <ComboBox x:Name="cmbKapatmaEylemi" Style="{StaticResource DlgCombo}" Width="280" HorizontalAlignment="Left">
                            <ComboBoxItem Content="{conv:Loc Lbl_KapatmaSor}"/>
                            <ComboBoxItem Content="{conv:Loc Lbl_KapatmaCik}"/>
                            <ComboBoxItem Content="{conv:Loc Lbl_KapatmaKucult}"/>
                        </ComboBox>

                        <TextBlock Text="{conv:Loc Lbl_GuvenlikGiris}" Style="{StaticResource DlgLabel}" Margin="0,18,0,3"/>
                        <CheckBox x:Name="chkSifre" Content="{conv:Loc Lbl_SifreKorumasi}"
                                  FontFamily="Segoe UI" FontSize="12" Margin="0,6,0,0"/>

                        <TextBlock Text="{conv:Loc Lbl_GorunumVeListeler}" Style="{StaticResource DlgLabel}" Margin="0,18,0,3"/>
                        <CheckBox x:Name="chkZebraGrid" Content="{conv:Loc Lbl_ZebraGrid}"
                                  FontFamily="Segoe UI" FontSize="12" Margin="0,6,0,0"/>

                        <TextBlock Text="{conv:Loc Lbl_FiltreVarsayilanlari}" Style="{StaticResource DlgLabel}" Margin="0,18,0,3"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{conv:Loc Lbl_VarsayilanAramaModu}" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" Margin="0,0,12,8"/>
                            <ComboBox x:Name="cmbDefAramaModu" Grid.Row="0" Grid.Column="1" Style="{StaticResource DlgCombo}" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <ComboBoxItem Content="{conv:Loc Filter_ModYazildigi}"/>
                                <ComboBoxItem Content="{conv:Loc Filter_ModIceren}"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{conv:Loc Lbl_VarsayilanHesapDurumu}" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" Margin="0,0,12,8"/>
                            <ComboBox x:Name="cmbDefHesapDurumu" Grid.Row="1" Grid.Column="1" Style="{StaticResource DlgCombo}" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <ComboBoxItem Content="{conv:Loc Filter_HesapTumu}"/>
                                <ComboBoxItem Content="{conv:Loc Filter_HesapAktif}"/>
                                <ComboBoxItem Content="{conv:Loc Filter_HesapPasif}"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{conv:Loc Lbl_VarsayilanBakiyeFiltresi}" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" Margin="0,0,12,8"/>
                            <ComboBox x:Name="cmbDefBakiyeFiltresi" Grid.Row="2" Grid.Column="1" Style="{StaticResource DlgCombo}" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <ComboBoxItem Content="{conv:Loc Filter_BakiyeTumu}"/>
                                <ComboBoxItem Content="{conv:Loc Filter_BakiyeBorclular}"/>
                                <ComboBoxItem Content="{conv:Loc Filter_BakiyeAlacaklilar}"/>
                                <ComboBoxItem Content="{conv:Loc Filter_BakiyeSifirOlmayan}"/>
                                <ComboBoxItem Content="{conv:Loc Filter_BakiyeSifir}"/>
                                <ComboBoxItem Content="{conv:Loc Filter_LimitAsanlar}"/>
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="chkFiltreHatirla" Content="{conv:Loc Lbl_FiltreHatirla}"
                                  FontFamily="Segoe UI" FontSize="12" Margin="0,2,0,4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3. Yedekleme Ayarları -->
            <TabItem Header="{conv:Loc Tab_Yedekleme}">
                <StackPanel Margin="18,14">
                    <TextBlock Text="{conv:Loc Lbl_OtoYedekleme}" Style="{StaticResource DlgLabel}"/>
                    <ComboBox x:Name="cmbOtoYedek" Style="{StaticResource DlgCombo}" Width="240" HorizontalAlignment="Left">
                        <ComboBoxItem Content="0 — Yok"/>
                        <ComboBoxItem Content="1 — Her program kapanışında"/>
                        <ComboBoxItem Content="2 — Günde 1 kez"/>
                        <ComboBoxItem Content="3 — Haftada 1 kez"/>
                        <ComboBoxItem Content="4 — Her program açılışında"/>
                    </ComboBox>

                    <TextBlock Text="{conv:Loc Lbl_MaksYedek}" Style="{StaticResource DlgLabel}" Margin="0,12,0,3"/>
                    <ComboBox x:Name="cmbMaksYedek" Style="{StaticResource DlgCombo}" Width="160" HorizontalAlignment="Left">
                        <ComboBoxItem Content="5 adet"/>
                        <ComboBoxItem Content="10 adet"/>
                        <ComboBoxItem Content="20 adet"/>
                        <ComboBoxItem Content="50 adet"/>
                        <ComboBoxItem Content="Sınırsız"/>
                    </ComboBox>

                    <TextBlock Text="{conv:Loc Lbl_YedekKlasoru}" Style="{StaticResource DlgLabel}" Margin="0,12,0,3"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="edtYedekKlasoru" Style="{StaticResource DlgInput}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="{conv:Loc Btn_Sec}" Style="{StaticResource DlgBtn}" Margin="0,0,6,0" Click="BtnYedekKlasoruSec_Click"/>
                        <Button Grid.Column="2" Content="{conv:Loc Btn_Varsayilan}" Style="{StaticResource DlgBtn}" Margin="0" Click="BtnYedekKlasoruVarsayilan_Click"/>
                    </Grid>

                    <TextBlock x:Name="lblSonYedek" FontFamily="Segoe UI" FontSize="11" Foreground="#64748B" Margin="0,12,0,0"/>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,16,0,0">
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{conv:Loc Title_YedekYonetimi}" FontWeight="Bold" Foreground="#1E3A5F" FontSize="12"/>
                                <TextBlock Text="Mevcut yedekleri listele, geri yükle veya temizle." FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                            <Button Style="{StaticResource DlgPrimaryBtn}" Content="{conv:Loc Title_YedekYonetimi}"
                                    HorizontalAlignment="Right" Click="BtnYedekYonetimiAc_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- 4. Şifre Değiştir -->
            <TabItem Header="{conv:Loc Tab_Sifre}">
                <StackPanel Margin="18,14" MaxWidth="360" HorizontalAlignment="Left">
                    <TextBlock Text="{conv:Loc Tab_Sifre}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,0,6"/>
                    <TextBlock Text="Varsayılan program şifresi 'gel'dir." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,12"/>

                    <TextBlock Text="{conv:Loc Lbl_MevcutSifre}" Style="{StaticResource DlgLabel}"/>
                    <PasswordBox x:Name="edtEskiSifre" FontSize="13" Padding="6,5" BorderBrush="#CBD5E1"/>

                    <TextBlock Text="{conv:Loc Lbl_YeniSifre}" Style="{StaticResource DlgLabel}"/>
                    <PasswordBox x:Name="edtYeniSifre" FontSize="13" Padding="6,5" BorderBrush="#CBD5E1"/>

                    <TextBlock Text="{conv:Loc Lbl_YeniSifreTekrar}" Style="{StaticResource DlgLabel}"/>
                    <PasswordBox x:Name="edtYeniSifreTekrar" FontSize="13" Padding="6,5" BorderBrush="#CBD5E1"/>

                    <Button Content="{conv:Loc Btn_SifreGuncelle}" Style="{StaticResource DlgPrimaryBtn}"
                            HorizontalAlignment="Left" Margin="0,18,0,0" Click="BtnSifreGuncelle_Click"/>
                </StackPanel>
            </TabItem>

            <!-- 5. Açıklama Şablonları -->
            <TabItem Header="{conv:Loc Tab_Aciklamalar}">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{conv:Loc Lbl_IslemTuru}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="#1E3A5F" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbAciklamaTuru" Grid.Column="1" Style="{StaticResource DlgCombo}" SelectionChanged="CmbAciklamaTuru_SelectionChanged">
                            <ComboBoxItem Content="{conv:Loc Fis_Borc}"/>
                            <ComboBoxItem Content="{conv:Loc Fis_Tahsilat}"/>
                            <ComboBoxItem Content="{conv:Loc Fis_Alacak}"/>
                            <ComboBoxItem Content="{conv:Loc Fis_Odeme}"/>
                            <ComboBoxItem Content="{conv:Loc Fis_Devir}"/>
                        </ComboBox>
                    </Grid>

                    <!-- Yeni Açıklama Girişi -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="edtYeniAciklama" Style="{StaticResource DlgInput}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="{conv:Loc Btn_Ekle}" Style="{StaticResource DlgPrimaryBtn}" Margin="0" Click="BtnAciklamaEkle_Click"/>
                    </Grid>

                    <!-- Açıklama Listesi -->
                    <ListBox x:Name="lbAciklamalar" Grid.Row="2" BorderBrush="#CBD5E1"
                             FontFamily="Segoe UI" FontSize="12"/>

                    <!-- Sil Butonları -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="{conv:Loc Btn_SecileniSil}" Style="{StaticResource DlgBtn}" Margin="0,0,8,0" Click="BtnAciklamaSil_Click"/>
                        <Button Content="{conv:Loc Btn_TumunuSil}" Style="{StaticResource DlgBtn}" Margin="0" Click="BtnAciklamaTemizle_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Alt Butonlar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DlgBtn}" Content="{conv:Loc Btn_Iptal}" Click="BtnIptal_Click" IsCancel="True"/>
                <Button Style="{StaticResource DlgPrimaryBtn}" Content="{conv:Loc Btn_AyarlariKaydet}" Click="BtnKaydet_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

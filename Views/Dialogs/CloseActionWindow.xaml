<Window x:Class="GelesiyeWPF.Views.Dialogs.CloseActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GelesiyeWPF.Converters"
        Title="{conv:Loc Title_CikisOnayi}" Width="420" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/gelesiye.ico"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
        KeyDown="Window_KeyDown">
    <StackPanel>
        <!-- Başlık -->
        <Border Background="#107FD2" Height="40" MouseLeftButtonDown="Header_MouseDown">
            <Grid Margin="16,0,8,0">
                <TextBlock Text="{conv:Loc Title_CikisOnayi}" Foreground="White" FontFamily="Segoe UI"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        FontSize="14" Cursor="Hand" Width="30" Height="30"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>

        <!-- İçerik Kartı -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="16,14,16,8" Padding="16,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="❓" FontSize="26" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{conv:Loc Msg_KapatmakIstiyorMusunuz}" FontFamily="Segoe UI"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <TextBlock Text="{conv:Loc Msg_EylemiSeciniz}"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Separator Margin="0,12,0,10" Background="#F1F5F9"/>

                <CheckBox x:Name="chkRemember" Content="{conv:Loc Lbl_SecimiHatirla}"
                          FontFamily="Segoe UI" FontSize="12" Foreground="#475569" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Butonlar -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Button Style="{StaticResource DlgBtn}" Content="{conv:Loc Btn_Iptal}" HorizontalAlignment="Left"
                        Click="BtnCancel_Click" IsCancel="True" MinWidth="70"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource DlgBtn}" Content="{conv:Loc Btn_SimgeyeKucult}" Margin="0,0,8,0"
                            Click="BtnMinimize_Click"/>
                    <Button Style="{StaticResource DlgPrimaryBtn}" Content="{conv:Loc Btn_TamamenCik}"
                            Click="BtnExit_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>

<Window x:Class="GelesiyeWPF.Views.Dialogs.DekontEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GelesiyeWPF.Converters"
        Title="{conv:Loc Title_Fis}" Width="480" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/gelesiye.ico"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
        KeyDown="Window_KeyDown">
    <StackPanel>
        <Border x:Name="bdHeader" Background="#1E3A5F" Height="52" MouseLeftButtonDown="Header_MouseDown">
            <TextBlock x:Name="lblBaslik" Foreground="White" FontFamily="Segoe UI" FontSize="15"
                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="16,16,16,8" Padding="18,6,18,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{conv:Loc Lbl_Tarih}" Style="{StaticResource DlgLabel}"/>
                        <DatePicker x:Name="dtpTarih" FontSize="13" Padding="4,5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{conv:Loc Lbl_Saat}" Style="{StaticResource DlgLabel}"/>
                        <TextBox x:Name="edtSaat" Style="{StaticResource DlgInput}" TextAlignment="Center"
                                 MaxLength="5"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{conv:Loc Lbl_CariHesap}" Style="{StaticResource DlgLabel}"/>
                <TextBox x:Name="edtCariHesap" Style="{StaticResource DlgInput}" IsReadOnly="True" Background="#F8FAFC"/>

                <TextBlock Text="{conv:Loc Lbl_Aciklama}" Style="{StaticResource DlgLabel}"/>
                <ComboBox x:Name="cmbAciklama" Style="{StaticResource DlgCombo}" IsEditable="True"/>

                <TextBlock Text="{conv:Loc Lbl_Tutar}" Style="{StaticResource DlgLabel}"/>
                <TextBox x:Name="edtTutar" Style="{StaticResource DlgInput}" TextAlignment="Right"
                         FontSize="18" FontWeight="Bold" GotKeyboardFocus="EdtTutar_GotFocus"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,4,16,16">
            <Button Style="{StaticResource DlgBtn}" Content="{conv:Loc Btn_IptalEsc}" Click="BtnIptal_Click" IsCancel="True"/>
            <Button Style="{StaticResource DlgPrimaryBtn}" Content="{conv:Loc Btn_KaydetF2}" Click="BtnKaydet_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="GelesiyeWPF.Views.Dialogs.HakkindaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GelesiyeWPF.Converters"
        Title="{conv:Loc Title_Hakkinda}" Width="470" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/gelesiye.ico"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ContactCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Başlık Çubuğu -->
        <Border Background="#107FD2" Height="42" MouseLeftButtonDown="Header_MouseDown">
            <Grid Margin="16,0,8,0">
                <TextBlock Text="{conv:Loc Title_Hakkinda}" Foreground="White" FontFamily="Segoe UI"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        FontSize="14" Cursor="Hand" Width="30" Height="30"
                        Click="BtnKapat_Click"/>
            </Grid>
        </Border>

        <!-- İçerik -->
        <StackPanel Margin="16,14,16,14">
            <!-- Program Kartı -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assets/gelesiye.ico" Width="44" Height="44" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Gelesiye" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#107FD2"/>
                        <TextBlock Text="{conv:Loc App_Motto}" FontFamily="Segoe UI" FontSize="12" Foreground="#475569" Margin="0,1,0,0"/>
                        <TextBlock x:Name="lblVersion" Text="Versiyon v1.0.0 — 2026" FontFamily="Segoe UI" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Slogan -->
            <Border Background="#FEF9C3" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                <TextBlock Text="{conv:Loc Lbl_Slogan}"
                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" FontStyle="Italic"
                           Foreground="#854D0E" TextAlignment="Center" LineHeight="18"/>
            </Border>

            <!-- Geliştirici Kartı -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="{conv:Loc Lbl_Gelistirici}" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,2"/>
                    <TextBlock Text="Cihad Kocaşahan" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="#107FD2"/>
                    <TextBlock Text="Senior Software Developer" FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" Margin="0,2,0,12"/>

                    <!-- WhatsApp -->
                    <Border Style="{StaticResource ContactCard}" Background="#F0FDF4" BorderBrush="#BBF7D0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💬" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="WhatsApp" FontSize="10" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="+90 536 888 84 00" FontSize="12" FontWeight="SemiBold" Foreground="#15803D" Cursor="Hand" MouseDown="LnkWP_Click"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{conv:Loc Btn_MesajAt}" Style="{StaticResource ActionBtn}"
                                    Foreground="#166534" BorderBrush="#86EFAC" Click="LnkWP_Click"/>
                        </Grid>
                    </Border>

                    <!-- LinkedIn -->
                    <Border Style="{StaticResource ContactCard}" Background="#EFF6FF" BorderBrush="#BFDBFE">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💼" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="LinkedIn" FontSize="10" FontWeight="Bold" Foreground="#1E40AF"/>
                                <TextBlock Text="in/cihadkocasahan" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8" Cursor="Hand" MouseDown="LnkLinkedIn_Click"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{conv:Loc Btn_ProfiliAc}" Style="{StaticResource ActionBtn}"
                                    Foreground="#1E40AF" BorderBrush="#93C5FD" Click="LnkLinkedIn_Click"/>
                        </Grid>
                    </Border>

                    <!-- GitHub -->
                    <Border Style="{StaticResource ContactCard}" Background="#F8FAFC" BorderBrush="#E2E8F0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🐙" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="GitHub" FontSize="10" FontWeight="Bold" Foreground="#334155"/>
                                <TextBlock Text="github.com/cihadkocasahan" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Cursor="Hand" MouseDown="LnkGitHub_Click"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{conv:Loc Btn_SayfayiAc}" Style="{StaticResource ActionBtn}"
                                    Foreground="#334155" BorderBrush="#CBD5E1" Click="LnkGitHub_Click"/>
                        </Grid>
                    </Border>

                    <!-- E-Posta -->
                    <Border Style="{StaticResource ContactCard}" Background="#FFF7ED" BorderBrush="#FED7AA" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="✉" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="E-Posta" FontSize="10" FontWeight="Bold" Foreground="#9A3412"/>
                                <TextBlock Text="cihadkocasahan@gmail.com" FontSize="12" FontWeight="SemiBold" Foreground="#C2410C" Cursor="Hand" MouseDown="LnkEmail_Click"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{conv:Loc Btn_MesajAt}" Style="{StaticResource ActionBtn}"
                                    Foreground="#9A3412" BorderBrush="#FDBA74" Click="LnkEmail_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Alt Kısım -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <TextBlock Text="© 2026 Gelesiye. Tüm Hakları Saklıdır."
                           FontFamily="Segoe UI" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <Button Style="{StaticResource DlgPrimaryBtn}" Content="{conv:Loc Btn_Kapat}" HorizontalAlignment="Right" Click="BtnKapat_Click"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>

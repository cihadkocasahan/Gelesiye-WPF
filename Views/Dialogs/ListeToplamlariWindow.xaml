<Window x:Class="GelesiyeWPF.Views.Dialogs.ListeToplamlariWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GelesiyeWPF.Converters"
        Title="{conv:Loc Title_ListeToplamlari}" Width="440" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/gelesiye.ico"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="SumLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
        <Style x:Key="SumBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Header -->
        <Border Background="#107FD2" Height="42" MouseLeftButtonDown="Header_MouseDown">
            <Grid Margin="16,0,8,0">
                <TextBlock Text="{conv:Loc Title_ListeToplamlari}" Foreground="White" FontFamily="Segoe UI"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        FontSize="14" Cursor="Hand" Width="30" Height="30"
                        Click="BtnKapat_Click"/>
            </Grid>
        </Border>

        <!-- İçerik Kartı -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="16,14,16,12" Padding="18,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{conv:Loc Lbl_CariHesapBakiyeToplamlari}"
                           FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,0,4"/>

                <!-- Aktif -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Aktif Borçlu Toplam:" Style="{StaticResource SumLabel}"/>
                <TextBox x:Name="edtAktifBorclu" Grid.Row="2" Grid.Column="1" Style="{StaticResource SumBox}" Foreground="#D41A1A"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Aktif Alacaklı Toplam:" Style="{StaticResource SumLabel}"/>
                <TextBox x:Name="edtAktifAlacakli" Grid.Row="4" Grid.Column="1" Style="{StaticResource SumBox}" Foreground="#205E1B"/>

                <!-- Pasif -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Pasif Borçlu Toplam:" Style="{StaticResource SumLabel}"/>
                <TextBox x:Name="edtPasifBorclu" Grid.Row="6" Grid.Column="1" Style="{StaticResource SumBox}" Foreground="#D41A1A"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Pasif Alacaklı Toplam:" Style="{StaticResource SumLabel}"/>
                <TextBox x:Name="edtPasifAlacakli" Grid.Row="8" Grid.Column="1" Style="{StaticResource SumBox}" Foreground="#205E1B"/>

                <!-- Genel Toplamlar -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Genel Borçlu Toplam:" Style="{StaticResource SumLabel}" FontWeight="Bold"/>
                <TextBox x:Name="edtGenelBorclu" Grid.Row="10" Grid.Column="1" Style="{StaticResource SumBox}" Foreground="#D41A1A"/>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="Genel Alacaklı Toplam:" Style="{StaticResource SumLabel}" FontWeight="Bold"/>
                <TextBox x:Name="edtGenelAlacakli" Grid.Row="12" Grid.Column="1" Style="{StaticResource SumBox}" Foreground="#205E1B"/>

                <!-- Net Durum & Cari Sayısı -->
                <Border Grid.Row="14" Grid.ColumnSpan="2" Background="#F1F5F9" CornerRadius="4" Padding="12,8">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{conv:Loc Stat_NetBakiye}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="lblNetBakiye" FontSize="16" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="lblCariSayilari" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="11" Foreground="#475569" TextAlignment="Right"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Alt Toolbar -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <Button Style="{StaticResource DlgPrimaryBtn}" Content="{conv:Loc Btn_IptalEsc}" HorizontalAlignment="Right" Click="BtnKapat_Click" IsCancel="True"/>
        </Border>
    </StackPanel>
</Window>

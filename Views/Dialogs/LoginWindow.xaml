<Window x:Class="GelesiyeWPF.Views.Dialogs.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GelesiyeWPF.Converters"
        Title="{conv:Loc Title_Giris}" Width="380" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/gelesiye.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
        Loaded="Window_Loaded">
    <StackPanel>
        <Border Background="#107FD2" Height="56" MouseLeftButtonDown="Header_MouseDown">
            <TextBlock Text="{conv:Loc Title_Giris}" Foreground="White" FontFamily="Segoe UI"
                       FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="18,0"/>
        </Border>

        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="18,18,18,10" Padding="18,14,18,16">
            <StackPanel>
                <TextBlock Text="{conv:Loc Lbl_SifreGiriniz}" FontFamily="Segoe UI"
                           FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                <PasswordBox x:Name="edtSifre" Margin="0,12,0,0" FontSize="14" Padding="6,6"
                             BorderBrush="#CBD5E1" KeyDown="EdtSifre_KeyDown"/>
                <TextBlock x:Name="lblKalanHak" Text="Kalan Deneme: 3" FontFamily="Segoe UI"
                           FontSize="11" Foreground="#94A3B8" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,16">
            <Button Style="{StaticResource DlgBtn}" Content="{conv:Loc Btn_Cikis}" Click="BtnCikis_Click" IsCancel="True"/>
            <Button Style="{StaticResource DlgPrimaryBtn}" Content="{conv:Loc Btn_Giris}" Click="BtnGiris_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>

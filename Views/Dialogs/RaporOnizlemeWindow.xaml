<Window x:Class="GelesiyeWPF.Views.Dialogs.RaporOnizlemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GelesiyeWPF.Converters"
        Title="{conv:Loc Title_BaskiOnizleme}"
        Icon="pack://application:,,,/Assets/gelesiye.ico"
        Width="1020" Height="820"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#525659"
        BorderBrush="#107FD2" BorderThickness="1"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <!-- TitleBar Butonları -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A5FA0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D4880"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E53E3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C53030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar Buton Stili -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Yazdır Butonu Stili -->
        <Style x:Key="PrimaryPrintBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#107FD2"/>
            <Setter Property="BorderBrush" Value="#0D68AD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1492F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#107FD2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D68AD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>  <!-- 0: Başlık Çubuğu -->
            <RowDefinition Height="52"/>  <!-- 1: Eylem & Yazdırma Toolbar -->
            <RowDefinition Height="*"/>   <!-- 2: FlowDocument Okuyucu -->
        </Grid.RowDefinitions>

        <!-- 0: BAŞLIK ÇUBUĞU -->
        <Grid Grid.Row="0" Background="#107FD2" MouseLeftButtonDown="TitleBar_LeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                <TextBlock Text="🖨 " FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtTitle" Text="{conv:Loc Title_BaskiOnizleme}" FontSize="13" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" FontFamily="Segoe UI"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                <Button x:Name="btnMaximize" Style="{StaticResource TitleBarBtn}" Content="□" Click="BtnMaximize_Click"/>
                <Button Style="{StaticResource CloseBtn}" Content="✕" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- 1: EYLEM & YAZDIRMA TOOLBAR -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="False">
                <!-- Sol Taraf: Yazdır ve Görüntüleme Araçları -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- YAZDIR BUTONU (BÜYÜK VE BELİRGİN) -->
                    <Button x:Name="btnYazdir" Style="{StaticResource PrimaryPrintBtn}"
                            Content="{conv:Loc Btn_YazdirOnizle}" ToolTip="{conv:Loc Tooltip_Yazdir}"
                            Click="BtnYazdir_Click"/>

                    <!-- Ayraç -->
                    <Rectangle Width="1" Height="24" Fill="#E2E8F0" Margin="10,0"/>

                    <!-- Sayfa Düzenleri -->
                    <Button x:Name="btnTekSayfa" Style="{StaticResource ToolBtn}"
                            Content="{conv:Loc Btn_TekSayfa}" ToolTip="{conv:Loc Tooltip_TekSayfa}"
                            Click="BtnTekSayfa_Click"/>
                    <Button x:Name="btnCiftSayfa" Style="{StaticResource ToolBtn}"
                            Content="{conv:Loc Btn_CiftSayfa}" ToolTip="{conv:Loc Tooltip_CiftSayfa}"
                            Click="BtnCiftSayfa_Click"/>
                    <Button x:Name="btnKaydirma" Style="{StaticResource ToolBtn}"
                            Content="{conv:Loc Btn_SurekliKaydirma}" ToolTip="{conv:Loc Tooltip_Surekli}"
                            Click="BtnKaydirma_Click"/>

                    <!-- Ayraç -->
                    <Rectangle Width="1" Height="24" Fill="#E2E8F0" Margin="10,0"/>

                    <!-- Yakınlaştırma -->
                    <Button x:Name="btnUzaklas" Style="{StaticResource ToolBtn}"
                            Content="{conv:Loc Btn_Uzaklastir}" ToolTip="{conv:Loc Tooltip_Uzaklastir}"
                            Click="BtnUzaklas_Click"/>
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4"
                            Padding="8,0" Height="32" VerticalAlignment="Center">
                        <TextBlock x:Name="txtZoom" Text="100%" VerticalAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    </Border>
                    <Button x:Name="btnYakinlas" Style="{StaticResource ToolBtn}"
                            Content="{conv:Loc Btn_Yakinlastir}" ToolTip="{conv:Loc Tooltip_Yakinlastir}"
                            Click="BtnYakinlas_Click"/>
                    <Button x:Name="btnResetZoom" Style="{StaticResource ToolBtn}"
                            Content="{conv:Loc Btn_YuzdeYuz}" ToolTip="{conv:Loc Tooltip_YuzdeYuz}"
                            Click="BtnResetZoom_Click"/>
                </StackPanel>

                <!-- Sağ Taraf: Kapat Butonu -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolBtn}" Content="{conv:Loc Btn_IptalEsc}"
                            Height="34" Padding="14,0" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2: FLOWDOCUMENT OKUYUCU -->
        <Border Grid.Row="2" Background="#525659">
            <FlowDocumentReader x:Name="docReader"
                                ViewingMode="Page"
                                IsFindEnabled="True"
                                IsPrintEnabled="True"/>
        </Border>
    </Grid>
</Window>

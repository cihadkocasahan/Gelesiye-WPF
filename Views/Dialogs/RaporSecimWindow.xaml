<Window x:Class="GelesiyeWPF.Views.Dialogs.RaporSecimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GelesiyeWPF.Converters"
        Title="{conv:Loc Title_RaporSecimi}" Width="500" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/gelesiye.ico"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="RaporBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#107FD2"/>
                                <Setter TargetName="bd" Property="Background" Value="#F0F9FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Başlık -->
        <Border Background="#107FD2" Height="42" MouseLeftButtonDown="Header_MouseDown">
            <Grid Margin="16,0,8,0">
                <TextBlock Text="{conv:Loc Title_RaporSecimi}" Foreground="White" FontFamily="Segoe UI"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        FontSize="14" Cursor="Hand" Width="30" Height="30"
                        Click="BtnCancel_Click"/>
            </Grid>
        </Border>

        <!-- İçerik Kartı -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Margin="16,14,16,10" Padding="18,16">
            <StackPanel>
                <TextBlock Text="{conv:Loc Lbl_RaporSeciniz}"
                           FontFamily="Segoe UI" FontSize="12" Foreground="#64748B" Margin="0,0,0,14"/>

                <!-- 1: Seçili Cari Ekstresi -->
                <Button x:Name="btnSeciliEkstre" Style="{StaticResource RaporBtn}" Click="BtnSeciliEkstre_Click">
                    <DockPanel LastChildFill="True">
                        <!-- Sağ Aksiyon Butonu -->
                        <Border DockPanel.Dock="Right" Background="#107FD2" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="{conv:Loc Btn_RaporuAc}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <!-- Sol İkon ve Başlık -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📑 " FontSize="20" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Margin="8,0,8,0">
                                <TextBlock x:Name="lblCariEkstreBaslik" Text="{conv:Loc Rpr_SeciliEkstre}" FontWeight="Bold" FontSize="13" Foreground="#107FD2"/>
                                <TextBlock Text="{conv:Loc Rpr_SeciliEkstreSub}" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <!-- 2: Cari Özet Listesi -->
                <Button x:Name="btnCariOzet" Style="{StaticResource RaporBtn}" Click="BtnCariOzet_Click">
                    <DockPanel LastChildFill="True">
                        <!-- Sağ Aksiyon Butonu -->
                        <Border DockPanel.Dock="Right" Background="#1E3A5F" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="{conv:Loc Btn_RaporuAc}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <!-- Sol İkon ve Başlık -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄 " FontSize="20" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Margin="8,0,8,0">
                                <TextBlock Text="{conv:Loc Rpr_CariListesi}" FontWeight="Bold" FontSize="13" Foreground="#1E3A5F"/>
                                <TextBlock Text="{conv:Loc Rpr_CariListesiSub}" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <!-- 3: Detaylı Hareket Raporu -->
                <Button x:Name="btnGenelHareketler" Style="{StaticResource RaporBtn}" Margin="0" Click="BtnGenelHareketler_Click">
                    <DockPanel LastChildFill="True">
                        <!-- Sağ Aksiyon Butonu -->
                        <Border DockPanel.Dock="Right" Background="#1E3A5F" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="{conv:Loc Btn_RaporuAc}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <!-- Sol İkon ve Başlık -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊 " FontSize="20" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center" Margin="8,0,8,0">
                                <TextBlock Text="{conv:Loc Rpr_GenelHareketler}" FontWeight="Bold" FontSize="13" Foreground="#1E3A5F"/>
                                <TextBlock Text="{conv:Loc Rpr_GenelHareketlerSub}" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Alt Toolbar (Belirgin Butonlar) -->
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="btnGoruntule" Style="{StaticResource DlgPrimaryBtn}"
                            Content="{conv:Loc Btn_RaporuGoruntule}" Click="BtnGoruntule_Click"/>
                    <Button Style="{StaticResource DlgBtn}" Content="{conv:Loc Btn_IptalEsc}"
                            Click="BtnCancel_Click" IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</Window>

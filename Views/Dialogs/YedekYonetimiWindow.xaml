<Window x:Class="GelesiyeWPF.Views.Dialogs.YedekYonetimiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GelesiyeWPF.Converters"
        Title="{conv:Loc Title_YedekYonetimi}" Width="680" Height="480" MinWidth="540" MinHeight="360"
        Icon="pack://application:,,,/Assets/gelesiye.ico"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#107FD2" MouseLeftButtonDown="Header_MouseDown">
            <Grid Margin="16,0,8,0">
                <TextBlock Text="{conv:Loc Title_YedekYonetimi}" Foreground="White" FontFamily="Segoe UI"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Foreground="White"
                        FontSize="14" Cursor="Hand" Width="30" Height="30"
                        Click="BtnKapat_Click"/>
            </Grid>
        </Border>

        <!-- Üst Panel: Konum ve İstatistik -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Yedek Konumu:" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                               Foreground="#475569" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="edtKonum" Grid.Column="1" Style="{StaticResource DlgInput}"
                             IsReadOnly="True" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Konum Değiştir" Style="{StaticResource DlgBtn}"
                            Height="30" MinWidth="0" Margin="0,0,6,0" Click="BtnKonumDegistir_Click"/>
                    <Button Grid.Column="3" Content="Klasörü Aç" Style="{StaticResource DlgBtn}"
                            Height="30" MinWidth="0" Margin="0" Click="BtnKlasoruAc_Click"/>
                </Grid>

                <TextBlock x:Name="lblIstatistik" Grid.Row="1" FontFamily="Segoe UI" FontSize="11"
                           Foreground="#64748B" Margin="0,8,0,0" Text="Yedekler yükleniyor..."/>
            </Grid>
        </Border>

        <!-- Yedek Listesi -->
        <ListView x:Name="lvYedekler" Grid.Row="2" Background="White" BorderThickness="0"
                  AlternationCount="2"
                  ItemContainerStyle="{StaticResource ZebraListViewItem}"
                  FontFamily="Segoe UI" FontSize="12" SelectionMode="Single"
                  MouseDoubleClick="LvYedekler_DoubleClick" SelectionChanged="LvYedekler_SelectionChanged">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                    <GridViewColumn Header="{conv:Loc Col_DosyaAdi}" Width="220" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="{conv:Loc Col_Tarih}" Width="150" DisplayMemberBinding="{Binding CreationTime, StringFormat='dd.MM.yyyy HH:mm:ss'}"/>
                    <GridViewColumn Header="{conv:Loc Col_Boyut}" Width="100" DisplayMemberBinding="{Binding FormattedLength}"/>
                    <GridViewColumn Header="{conv:Loc Col_TamYol}" Width="180" DisplayMemberBinding="{Binding FullName}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Alt Butonlar -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="btnSimdiYedekle" Style="{StaticResource DlgPrimaryBtn}"
                            Content="{conv:Loc Btn_SimdiYedekle}" Margin="0,0,8,0" Click="BtnSimdiYedekle_Click"/>
                    <Button x:Name="btnGeriYukle" Style="{StaticResource DlgBtn}"
                            Content="{conv:Loc Btn_GeriYukle}" Margin="0,0,8,0" Click="BtnGeriYukle_Click" IsEnabled="False"/>
                    <Button x:Name="btnSil" Style="{StaticResource DlgBtn}"
                            Content="{conv:Loc Btn_Sil}" Margin="0" Click="BtnSil_Click" IsEnabled="False"/>
                </StackPanel>

                <Button Style="{StaticResource DlgBtn}" Content="{conv:Loc Btn_Kapat}"
                        HorizontalAlignment="Right" Click="BtnKapat_Click" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="GelesiyeWPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GelesiyeWPF.Converters"
        Title="Gelesiye — Basit Veresiye Takip"
        Icon="pack://application:,,,/Assets/gelesiye.ico"
        Height="640" Width="900"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="#107FD2"
        ResizeMode="CanResize"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:ParaFormatConverter x:Key="ParaFmt"/>
        <conv:BakiyeBrushConverter x:Key="BakiyeBrush"/>
        <conv:BakiyeTextConverter x:Key="BakiyeText"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>

        <!-- Flat buton stili -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Başlık çubuğu buton stili (mavi bg üzerinde) -->
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A5FA0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D4880"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kapat butonu stili (kırmızı hover) -->
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E53E3E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C53030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Özet kart stili -->
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8,12,8"/>
        </Style>

        <!-- Alt toolbar buton stili -->
        <Style x:Key="ToolBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Filtre ComboBox -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Border x:Name="LayoutBorder" Background="#107FD2">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="{Binding Source={x:Static SystemParameters.WindowResizeBorderThickness}}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid x:Name="LayoutRoot">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>   <!-- TitleBar -->
                <RowDefinition Height="*"/>    <!-- İçerik -->
                <RowDefinition Height="28"/>   <!-- StatusBar -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- SATIR 0: BAŞLIK ÇUBUĞU                                   -->
            <!-- ════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="#107FD2"
                  MouseDown="TitleBar_MouseDown"
                  MouseLeftButtonDown="TitleBar_LeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Logo + Başlık -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                        <TextBlock Text="GELESIYE" FontSize="15" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="{conv:Loc App_Motto}" FontSize="13"
                                   Foreground="#B3D9F5" VerticalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>

                    <!-- Orta: Firma adı -->
                    <TextBlock x:Name="lblFirmaBaslik" Grid.Column="1"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               FontSize="12" FontWeight="SemiBold" Foreground="White"
                               FontFamily="Segoe UI" Margin="0,0,8,0"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               MouseDown="TitleBar_MouseDown"/>

                    <!-- Sağ: Pencere butonları -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,4,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="btnMenu" Style="{StaticResource TitleBarBtn}"
                                Content="⚙" ToolTip="{conv:Loc Tooltip_Menu}"
                                FontSize="15"
                                Click="BtnMenu_Click"/>
                        <Button x:Name="btnMinimize" Style="{StaticResource TitleBarBtn}"
                                Content="—" ToolTip="{conv:Loc Tooltip_Minimize}"
                                Click="BtnMinimize_Click"/>
                        <Button x:Name="btnMaximize" Style="{StaticResource TitleBarBtn}"
                                Content="□" ToolTip="{conv:Loc Tooltip_Maximize}"
                                Click="BtnMaximize_Click"/>
                        <Button x:Name="btnClose" Style="{StaticResource CloseBtn}"
                                Content="✕" ToolTip="{conv:Loc Tooltip_Close}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
            </Grid>

        <!-- ════════════════════════════════════════════════════════ -->
        <!-- SATIR 1: ANA İÇERİK (Tab sayfaları)                      -->
        <!-- ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ── CAR İ L İ S T E S İ  S A Y F A S I ── -->
            <Grid x:Name="pgCariList" Background="#F1F5F9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/> <!-- Özet kartlar -->
                    <RowDefinition Height="46"/>  <!-- Filtre çubuğu -->
                    <RowDefinition Height="*"/>   <!-- Liste -->
                    <RowDefinition Height="56"/>  <!-- Alt toolbar -->
                </Grid.RowDefinitions>

                <!-- Özet Kartlar -->
                <Grid Grid.Row="0" Background="#F1F5F9" x:Name="pnlCards">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SummaryCard}" Margin="12,10,6,10">
                        <StackPanel>
                            <TextBlock x:Name="lblCardBorcTitle" Text="{conv:Loc Stat_ToplamBorc}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="valCardBorc" Text="0,00 TL"
                                       FontSize="18" FontWeight="Bold" Foreground="#D41A1A"/>
                            <TextBlock x:Name="lblCardBorcSub" Text="{conv:Loc Stat_BorcluCariSub}"
                                       FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SummaryCard}" Margin="6,10,6,10">
                        <StackPanel>
                            <TextBlock x:Name="lblCardAlacakTitle" Text="{conv:Loc Stat_ToplamAlacak}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="valCardAlacak" Text="0,00 TL"
                                       FontSize="18" FontWeight="Bold" Foreground="#205E1B"/>
                            <TextBlock x:Name="lblCardAlacakSub" Text="{conv:Loc Stat_AlacakliCariSub}"
                                       FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SummaryCard}" Margin="6,10,6,10">
                        <StackPanel>
                            <TextBlock x:Name="lblCardNetTitle" Text="{conv:Loc Stat_NetBakiye}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="valCardNet" Text="0,00 TL"
                                       FontSize="18" FontWeight="Bold" Foreground="#1E3A5F"/>
                            <TextBlock x:Name="lblCardNetSub" Text="{conv:Loc Stat_NetDurumSub}"
                                       FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource SummaryCard}" Margin="6,10,12,10">
                        <StackPanel>
                            <TextBlock x:Name="lblCardCariTitle" Text="{conv:Loc Stat_MusteriSayisi}"
                                       FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="valCardCari" Text="Aktif: 0  |  Pasif: 0"
                                       FontSize="13" FontWeight="Bold" Foreground="#1E3A5F"/>
                            <TextBlock x:Name="lblCardCariSub" Text="Borçlu: 0  |  Alacaklı: 0  |  Sıfır: 0"
                                       FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Filtre Çubuğu -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="195"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="edtAramaMetni" Grid.Column="0"
                                 Height="24" Margin="0,0,6,0" VerticalContentAlignment="Center"
                                 FontSize="12" Padding="6,2"
                                 ToolTip="{conv:Loc Filter_AramaPlaceholder}"
                                 TextChanged="EdtAramaMetni_TextChanged"
                                 KeyDown="EdtAramaMetni_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="White" BorderBrush="#CBD5E1"
                                                        BorderThickness="1" CornerRadius="4">
                                                    <Grid>
                                                        <TextBlock x:Name="Placeholder"
                                                                   Text="{conv:Loc Filter_AramaPlaceholder}"
                                                                   Foreground="#94A3B8" FontSize="12"
                                                                   VerticalAlignment="Center" Margin="6,0"
                                                                   Visibility="Collapsed" IsHitTestVisible="False"/>
                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="Text" Value=""/>
                                                            <Condition Property="IsFocused" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <ComboBox x:Name="cmbAra" Grid.Column="1" Margin="0,0,6,0"
                                  Style="{StaticResource FilterCombo}"
                                  ToolTip="Arama Yöntemi"
                                  SelectionChanged="CmbAra_SelectionChanged">
                            <ComboBoxItem Content="{conv:Loc Filter_ModYazildigi}" IsSelected="True"/>
                            <ComboBoxItem Content="{conv:Loc Filter_ModIceren}"/>
                        </ComboBox>

                        <ComboBox x:Name="cmbHesap" Grid.Column="2" Margin="0,0,6,0"
                                  Style="{StaticResource FilterCombo}"
                                  ToolTip="Hesap Durumu Filtresi"
                                  SelectionChanged="CmbHesap_SelectionChanged">
                            <ComboBoxItem Content="{conv:Loc Filter_HesapTumu}" IsSelected="True"/>
                            <ComboBoxItem Content="{conv:Loc Filter_HesapAktif}"/>
                            <ComboBoxItem Content="{conv:Loc Filter_HesapPasif}"/>
                        </ComboBox>

                        <ComboBox x:Name="cmbFiltre" Grid.Column="3"
                                  Style="{StaticResource FilterCombo}"
                                  ToolTip="Bakiye Filtresi"
                                  SelectionChanged="CmbFiltre_SelectionChanged">
                            <ComboBoxItem Content="{conv:Loc Filter_BakiyeTumu}" IsSelected="True"/>
                            <ComboBoxItem Content="{conv:Loc Filter_BakiyeBorclular}"/>
                            <ComboBoxItem Content="{conv:Loc Filter_BakiyeAlacaklilar}"/>
                            <ComboBoxItem Content="{conv:Loc Filter_BakiyeSifirOlmayan}"/>
                            <ComboBoxItem Content="{conv:Loc Filter_BakiyeSifir}"/>
                            <ComboBoxItem Content="{conv:Loc Filter_LimitAsanlar}"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Cari Listesi -->
                <ListView x:Name="lvCariler" Grid.Row="2"
                          Background="White" BorderThickness="0"
                          SelectionMode="Single"
                          AlternationCount="2"
                          ItemContainerStyle="{StaticResource ZebraListViewItem}"
                          FontFamily="Segoe UI" FontSize="12"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          MouseDoubleClick="LvCariler_DoubleClick"
                          SelectionChanged="LvCariler_SelectionChanged">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                            <GridViewColumn x:Name="colCariKod"   Header="{conv:Loc Col_CariKodu}"   Width="90"  DisplayMemberBinding="{Binding CariKodu}"/>
                            <GridViewColumn x:Name="colUnvan"     Header="{conv:Loc Col_Unvan}"      Width="240" DisplayMemberBinding="{Binding Unvan}"/>
                            <GridViewColumn x:Name="colNotlar"    Header="{conv:Loc Col_Aciklama}"   Width="180" DisplayMemberBinding="{Binding Notlar}"/>
                            <GridViewColumn x:Name="colSehir"     Header="{conv:Loc Col_IlIlce}"     Width="100" DisplayMemberBinding="{Binding Il}"/>
                            <GridViewColumn x:Name="colSonIslem"  Header="{conv:Loc Col_SonIslem}"   Width="105">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SonIslemTarihi, StringFormat=dd.MM.yyyy}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="colBakiye"    Header="{conv:Loc Col_Bakiye}"     Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Bakiye, Converter={StaticResource BakiyeText}}"
                                                   Foreground="{Binding Bakiye, Converter={StaticResource BakiyeBrush}}"
                                                   HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   Margin="0,0,4,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Alt Toolbar (Cari) -->
                <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol: CRUD butonları -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="btnEkle" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"
                                    Content="➕" ToolTip="{conv:Loc Btn_Ekle}"
                                    Click="BtnEkle_Click"/>
                            <Button x:Name="btnDegistir" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"
                                    Content="✏" ToolTip="{conv:Loc Btn_Duzenle}"
                                    Click="BtnDegistir_Click"/>
                            <Button x:Name="btnSil" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"
                                    Content="🗑" ToolTip="{conv:Loc Btn_Sil}"
                                    Click="BtnSil_Click"/>
                            <Button x:Name="btnOzet" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"
                                    Content="∑" ToolTip="{conv:Loc Btn_Ozet}"
                                    FontSize="18"
                                    Click="BtnOzet_Click"/>
                            <Button x:Name="btnYazdir" Style="{StaticResource ToolBtn}"
                                    Content="🖨" ToolTip="{conv:Loc Btn_Yazdir}"
                                    Click="BtnYazdir_Click"/>
                        </StackPanel>

                        <!-- Sağ: Hareketler -->
                        <Button Grid.Column="2" x:Name="btnHareketler"
                                Height="36" Padding="16,0" MinWidth="200"
                                Background="#107FD2" Foreground="White"
                                FontSize="13" FontWeight="SemiBold"
                                FontFamily="Segoe UI"
                                ToolTip="{conv:Loc Btn_Hareketler}"
                                Click="BtnHareketler_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0D6FBF"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="{conv:Loc Btn_Hareketler}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── H A R E K E T L E R  S A Y F A S I ── -->
            <Grid x:Name="pgHareketler" Background="#F1F5F9" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/> <!-- Cari + özet kartlar -->
                    <RowDefinition Height="*"/>   <!-- Hareket listesi -->
                    <RowDefinition Height="56"/>  <!-- Alt toolbar -->
                </Grid.RowDefinitions>

                <!-- Üst Özet -->
                <Grid Grid.Row="0" Background="#F1F5F9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cari Kart -->
                    <Border Grid.Column="0" Style="{StaticResource SummaryCard}" Margin="12,10,6,10">
                        <StackPanel>
                            <TextBlock x:Name="lblHrkCariUnvan" Text="CARİ ADI"
                                       FontSize="14" FontWeight="Bold" Foreground="#1E3A5F"
                                       TextTrimming="CharacterEllipsis" MaxWidth="196"/>
                            <TextBlock x:Name="lblHrkCariIl" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                            <TextBlock x:Name="lblHrkCariTel" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Toplam Borç -->
                    <Border Grid.Column="1" Style="{StaticResource SummaryCard}" Margin="6,10,6,10">
                        <StackPanel>
                            <TextBlock Text="{conv:Loc Stat_ToplamBorc}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="valHrkBorc" Text="0,00 TL" FontSize="18" FontWeight="Bold" Foreground="#D41A1A"/>
                            <TextBlock Text="{conv:Loc Stat_BorcGirisleri}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Toplam Alacak -->
                    <Border Grid.Column="2" Style="{StaticResource SummaryCard}" Margin="6,10,6,10">
                        <StackPanel>
                            <TextBlock Text="{conv:Loc Stat_ToplamAlacak}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="valHrkAlacak" Text="0,00 TL" FontSize="18" FontWeight="Bold" Foreground="#205E1B"/>
                            <TextBlock Text="{conv:Loc Stat_AlacakGirisleri}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Bakiye -->
                    <Border Grid.Column="3" Style="{StaticResource SummaryCard}" Margin="6,10,6,10">
                        <StackPanel>
                            <TextBlock Text="{conv:Loc Stat_Bakiye}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="valHrkBakiye" Text="0,00 TL" FontSize="18" FontWeight="Bold" Foreground="#1E3A5F"/>
                            <TextBlock Text="{conv:Loc Stat_NetDurum}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- İşlem Sayısı -->
                    <Border Grid.Column="4" Style="{StaticResource SummaryCard}" Margin="6,10,12,10">
                        <StackPanel>
                            <TextBlock Text="{conv:Loc Stat_IslemSayisi}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                            <TextBlock x:Name="valHrkIslem" Text="0" FontSize="18" FontWeight="Bold" Foreground="#1E3A5F"/>
                            <TextBlock Text="{conv:Loc Stat_HareketKaydi}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Hareket Listesi -->
                <ListView x:Name="lvHareketler" Grid.Row="1"
                          Background="White" BorderThickness="0"
                          SelectionMode="Single"
                          AlternationCount="2"
                          ItemContainerStyle="{StaticResource ZebraListViewItem}"
                          FontFamily="Segoe UI" FontSize="12"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="LvHareketler_DoubleClick"
                          SelectionChanged="LvHareketler_SelectionChanged">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ListHeader}">
                            <GridViewColumn Header="{conv:Loc Col_Tarih}"       Width="115">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{conv:Loc Col_IslemTuru}"  Width="130" DisplayMemberBinding="{Binding IslemTuruText}"/>
                            <GridViewColumn Header="{conv:Loc Col_Aciklama}"    Width="220" DisplayMemberBinding="{Binding Aciklama}"/>
                            <GridViewColumn Header="{conv:Loc Col_Borc}"        Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Margin="0,0,4,0"
                                                   Foreground="#D41A1A" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Borc}" Value="0">
                                                            <Setter Property="Text" Value=""/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Text" Value="{Binding Borc, StringFormat=N2}"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{conv:Loc Col_Alacak}"      Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" Margin="0,0,4,0"
                                                   Foreground="#205E1B" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Alacak}" Value="0">
                                                            <Setter Property="Text" Value=""/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                    <Setter Property="Text" Value="{Binding Alacak, StringFormat=N2}"/>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{conv:Loc Col_YuruyenBakiye}" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding YuruyenBakiye, StringFormat=N2}"
                                                   Foreground="{Binding YuruyenBakiye, Converter={StaticResource BakiyeBrush}}"
                                                   HorizontalAlignment="Right" Margin="0,0,4,0"
                                                   FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Alt Toolbar (Hareket) -->
                <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                    <Grid Margin="8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Geri butonu -->
                        <Button Grid.Column="0" x:Name="btnCariListesi"
                                Style="{StaticResource ToolBtn}"
                                Content="↩" FontSize="18" FontWeight="Bold"
                                ToolTip="{conv:Loc Btn_CariListesi}"
                                Click="BtnCariListesi_Click"/>

                        <!-- Fiş butonları -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button x:Name="btnHrkFisler" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"
                                    Content="+" FontSize="18" FontWeight="Bold"
                                    ToolTip="{conv:Loc Btn_Fisler}"
                                    Click="BtnHrkFisler_Click"/>
                            <Button x:Name="btnHrkDuzenle" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"
                                    Content="✏" ToolTip="{conv:Loc Btn_Duzenle}"
                                    Click="BtnHrkDuzenle_Click"/>
                            <Button x:Name="btnHrkSil" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"
                                    Content="🗑" ToolTip="{conv:Loc Btn_Sil}"
                                    Click="BtnHrkSil_Click"/>
                            <Button x:Name="btnHrkYazdir" Style="{StaticResource ToolBtn}"
                                    Content="🖨" ToolTip="{conv:Loc Btn_Yazdir}"
                                    Click="BtnHrkYazdir_Click"/>
                        </StackPanel>

                        <!-- Önceki / Sonraki Cari -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="btnOncekiCari" Style="{StaticResource ToolBtn}" Margin="0,0,4,0"
                                    Content="◀" ToolTip="{conv:Loc Tooltip_OncekiCari}"
                                    Click="BtnOncekiCari_Click"/>
                            <Button x:Name="btnSonrakiCari" Style="{StaticResource ToolBtn}"
                                    Content="▶" ToolTip="{conv:Loc Tooltip_SonrakiCari}"
                                    Click="BtnSonrakiCari_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ════════════════════════════════════════════════════════ -->
        <!-- SATIR 2: DURUM ÇUBUĞU                                   -->
        <!-- ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblStatus" Grid.Column="0"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="#0F172A" FontFamily="Segoe UI"
                           Text="{conv:Loc Status_CariListesi}"/>

                <TextBlock x:Name="lblDovizKur" Grid.Column="1"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="#64748B" FontFamily="Segoe UI"
                           Margin="0,0,12,0" Cursor="Hand"
                           MouseDown="LblDovizKur_Click"/>

                <Button x:Name="btnHesapMakinesi" Grid.Column="2"
                        Background="Transparent" BorderThickness="0"
                        Height="22" Padding="8,0" FontSize="11"
                        Foreground="#64748B" Cursor="Hand"
                        ToolTip="{conv:Loc Tooltip_HesapMakinesi}"
                        Content="{conv:Loc Btn_HesapMakinesi}"
                        Click="BtnHesapMakinesi_Click"/>

                <TextBlock x:Name="lblVersion" Grid.Column="3"
                           VerticalAlignment="Center" FontSize="10"
                           Foreground="#94A3B8" FontFamily="Segoe UI"
                           Margin="0,0,4,0"/>
            </Grid>
        </Border>
    </Grid>
    </Border>

    <!-- ContextMenu: Fiş Ekleme -->
    <Window.ContextMenu>
        <ContextMenu x:Name="ctxFisler">
            <MenuItem x:Name="miHesabaBorcEkle"   Header="{conv:Loc Fis_Borc}"     Click="MiHesabaBorcEkle_Click"/>
            <MenuItem x:Name="miTahsilatYap"       Header="{conv:Loc Fis_Tahsilat}" Click="MiTahsilat_Click"/>
            <MenuItem x:Name="miHesabaAlacakEkle" Header="{conv:Loc Fis_Alacak}"   Click="MiHesabaAlacak_Click"/>
            <MenuItem x:Name="miOdemeYap"          Header="{conv:Loc Fis_Odeme}"    Click="MiOdeme_Click"/>
        </ContextMenu>
    </Window.ContextMenu>
</Window>
